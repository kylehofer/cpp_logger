    "keywords": "log, logging, debug, embedded, pico, esp8266, esp32, arduino",
    "repository": {
        "type": "git",
        "url": "https://github.com/kylehofer/cpp_logger.git"
    },
    "build": {
        "srcFilter": [
            "+<**/*.c>",
            "+<**/*.cpp>",
            "-<**/tests/*>"
        ]
    },
    "authors": [
        {
            "name": "Kyle Hofer",
            "email": "kylehofer@neurak.com.au",
            "url": "https://www.neurak.au",
            "maintainer": true
        }
    ],
    "license": "MIT",
    "homepage": "https://www.neurak.au",
    "frameworks": "*",
    "platforms": "*"
}
